# Variabili d'ambiente dell'applicazione
#
# modalita' di esecuzione del server (debug, release)
GIN_MODE=debug
#
# global timezone
TIMEZONE=Europe/Rome
#
# stringa di connessione al db (172.17.0.1 e' l'IP assegnato al gateway di Docker)
DBCONNECT=postgres://postgres:password@172.17.0.1:5432/ballroom
# 
# host e porta su cui risponde il server http (eventualmente rimappato nel container docker)
HTTPPROTOCOL=http
HTTPHOST=
HTTPPORT=8080
#
# server origin
# HTTP_ORIGIN=http://172.17.0.1:8081
HTTP_ORIGIN=http://172.17.0.3:8080
#
# CORS Headers
HDR_ALLOW_ORIGIN=same
HDR_ALLOW_CREDENTIALS=true
HDR_ALLOW_HEADERS=Content-Type, Content-Length, Accept-Encoding, X-CSRF-Token, Authorization, Accept, Origin, Cache-Control, X-Requested-With
HDR_ALLOW_METHODS=POST, OPTIONS, GET, PUT, DELETE
HDR_CONTENT_TYPE=application/json
#
# impostazione logger (loglevel: Debug, Info, Warning, Error)
LOGFILE=logfile.log
LOGLEVEL=Debug
#
# icona
FAVICON=resources/ballerini.ico
#
# PASSWORD UTENTE
# durata validita' password (in giorni)
PASSWTIMEVAL=90
# lunghezza minima
PASSWLEN=12
#
# PASSWORD TEMPORANEA (prima iscrizione o rinnovo)
# durata validita' password temporanea (in ore)
TEMPPASSWTIMEVAL=48
#
# JWT 
# secret key
JWTSECRET=ebde3cc72fe92a6bf9cffc07ab214bcda2c259eaf6cf044dc5976617c8432a3ed4e0363cb76dbdeabbb92aaa455478d4a0f565759892898a6dc526024c837696
# expiration time (in ore)
JWTEXPTIME=1
#
# RBAC config file
RBACFILE=rbac.json